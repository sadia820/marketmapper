# Copy to .env and fill in. Never commit .env.

# Required: long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional AI analysis. Fill in ONE of these keys (otherwise rule-based analysis is used).
# Anthropic keys start with sk-ant-   |   OpenAI keys start with sk-proj- or sk-
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# auto = use whichever key is set (Anthropic first). Or force: anthropic / openai
AI_PROVIDER=auto

# Set to false after your team has signed up
ALLOW_SIGNUP=true

POSTGRES_PASSWORD=marketmapper
WEB_PORT=8080

# Limits
MAX_UPLOAD_MB=10
MAX_ROWS_PER_UPLOAD=2000
MAX_PAGES_PER_SITE=4
